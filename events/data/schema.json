{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Korea Advanced Technology Event",
  "type": "object",
  "required": ["id", "title", "topics", "organizer", "startDate", "status", "priority"],
  "properties": {
    "id": {"type": "string", "description": "Stable URL slug. Never change after publication."},
    "title": {"type": "string"},
    "titleKo": {"type": "string"},
    "titleZh": {"type": "string"},
    "summary": {"type": "string"},
    "topics": {"type": "array", "items": {"type": "string"}},
    "organizer": {"type": "array", "items": {"type": "string"}},
    "participants": {"type": "array", "items": {"type": "string"}},
    "speakers": {"type": "array", "items": {"type": "string"}},
    "startDate": {"type": "string"},
    "endDate": {"type": "string"},
    "location": {"type": "string"},
    "language": {"type": "string"},
    "status": {"enum": ["watch", "announced", "registration_open", "registration_closing", "upcoming", "ongoing", "completed"]},
    "registrationOpen": {"type": "string"},
    "registrationDeadline": {"type": "string"},
    "registrationUrl": {"type": "string"},
    "registrationEligibility": {"type": "string"},
    "fee": {"type": "string"},
    "officialUrl": {"type": "string"},
    "publishedAt": {"type": "string"},
    "sourceType": {"type": "string"},
    "priority": {"enum": ["S", "A", "B", "C"]},
    "operatorRelevance": {"enum": ["high", "medium", "low"]},
    "whyItMatters": {"type": "string"},
    "agenda": {"type": "array", "items": {"type": "object", "properties": {"time": {"type": "string"}, "title": {"type": "string"}, "speaker": {"type": "string"}}}},
    "insights": {"type": "array", "items": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string"}, "date": {"type": "string"}, "summary": {"type": "string"}, "url": {"type": "string"}}}}
  }
}
